# ================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND (ONLINE RETAIL ANALYTICS)
# Cơ sở dữ liệu: MongoDB (NoSQL)
# ================================================================

# --- Application Settings ---
APP_NAME="Online Retail Analytics API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# --- Server Host & Port ---
HOST=0.0.0.0
PORT=8000

# --- Database Credentials (MongoDB NoSQL) ---
# Dùng "mongodb://localhost:27017" khi chạy trực tiếp trên máy
# Dùng "mongodb://mongodb:27017" khi chạy trong Docker Compose
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=online_retail
MONGODB_TEST_DATABASE=online_retail_test

# --- CORS Settings (Cho phép React Frontend kết nối) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
